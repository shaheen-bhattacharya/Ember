// Arithmetic, precedence, and grouping.
print 1 + 2 * 3;        // expect: 7
print (1 + 2) * 3;      // expect: 9
print 10 - 4 / 2;       // expect: 8
print -5 + 3;           // expect: -2
print 7 % 3;            // expect: 1
print 1 / 4;            // expect: 0.25
print 2 * 2 * 2 * 2;    // expect: 16
print -(3 - 5);         // expect: 2
